{
  "info": {
    "name": "DigiPocket API",
    "_postman_id": "digipocket-collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/auth/register",
          "host": [
            "http://localhost:8080"
          ],
          "path": [
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"username\":\"Akash\",\"email\":\"akash@example.com\",\"password\":\"secret123\"}"
        }
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/auth/login",
          "host": [
            "http://localhost:8080"
          ],
          "path": [
            "auth",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"akash@example.com\",\"password\":\"secret123\"}"
        }
      }
    },
    {
      "name": "List Expenses",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/expenses",
          "host": [
            "http://localhost:8080"
          ],
          "path": [
            "expenses"
          ]
        }
      }
    },
    {
      "name": "Create Expense",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "http://localhost:8080/expenses",
          "host": [
            "http://localhost:8080"
          ],
          "path": [
            "expenses"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Dinner\",\"category\":\"Food\",\"amount\":500,\"date\":\"2025-08-16\"}"
        }
      }
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": ""
    }
  ]
}